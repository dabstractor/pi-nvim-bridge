{
  "name": "pi-nvim-bridge",
  "version": "0.1.0",
  "description": "Bridge pi's autocomplete engine to an external $EDITOR (Neovim) over a local Unix socket.",
  "type": "module",
  "keywords": ["pi-package", "pi", "neovim", "completion"],
  "license": "MIT",
  "author": "Dustin Schultz",
  "homepage": "https://github.com/dabstractor/pi-nvim-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dabstractor/pi-nvim-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/dabstractor/pi-nvim-bridge/issues"
  },
  "files": [
    "extension/*.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": ["./extension/pi-nvim-bridge.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "jiti": "^2.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p extension/tsconfig.json",
    "test": "echo 'See README — tests run via node --import jiti-register extension/tests/*.test.ts (node:test, not vitest)' && exit 0"
  }
}
